[configuration]
entry_symbol = "digger_physics_library_init"
compatibility_minimum = "4.4"

; DiggerPhysics is registered as an Engine singleton so GDScript can call
; Engine.get_singleton("DiggerPhysics") without needing a scene node.
; VoxelTerrain is a Node3D subclass added directly to terrain.tscn.

[libraries]
linux.debug.x86_64   = "res://bin/libdigger_physics.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libdigger_physics.linux.template_release.x86_64.so"
windows.debug.x86_64   = "res://bin/libdigger_physics.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/libdigger_physics.windows.template_release.x86_64.dll"
macos.debug   = "res://bin/libdigger_physics.macos.template_debug.universal.dylib"
macos.release = "res://bin/libdigger_physics.macos.template_release.universal.dylib"

[icons]
DiggerPhysics = "res://assets/textures/icon_digger_physics.svg"
VoxelTerrain  = "res://assets/textures/icon_voxel_terrain.svg"

[gd_scene load_steps=3 format=3 uid="uid://terrain_scene"]

[ext_resource type="Script" path="res://scripts/terrain_manager.gd" id="1_mgr"]

; Terrain root — the DiggerPhysics GDExtension's VoxelTerrain node manages
; the actual voxel grid and mesh generation. This scene wires it into the
; game world and provides a GDScript-visible interface.

[node name="Terrain" type="Node3D"]
script = ExtResource("1_mgr")

; VoxelTerrain is registered by the digger_physics GDExtension.
; It will be replaced by the real GDExtension node once compiled.
; For now a placeholder StaticBody3D represents the ground.
[node name="GroundPlaceholder" type="StaticBody3D" parent="."]

[node name="CollisionShape3D" type="CollisionShape3D" parent="GroundPlaceholder"]
shape = BoxShape3D(new("BoxShape3D", {"size": Vector3(64, 1, 64)}))
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -0.5, 0)

[node name="MeshInstance3D" type="MeshInstance3D" parent="GroundPlaceholder"]
mesh = PlaneMesh(new("PlaneMesh", {
"size": Vector2(64, 64),
"subdivide_width": 0,
"subdivide_depth": 0
}))

[submodule "godot/physics/godot-cpp"]
    path = godot/physics/godot-cpp
    url = https://github.com/godotengine/godot-cpp.git
    branch = godot-4.4

[submodule "godot/third_party/godot_voxel"]
    path = godot/third_party/godot_voxel
    url = https://github.com/Zylann/godot_voxel.git

[submodule "third_party/chrono"]
    path = third_party/chrono
    url = https://github.com/projectchrono/chrono.git
    # Shared across engine experiments. Only clone when enabling DIGGER_USE_CHRONO (Phase 6).
    # Run: git submodule update --init third_party/chrono
